# Raiz do site na Hostinger (o repositório é clonado direto na pasta do domínio).
Options -Indexes
ErrorDocument 404 /404.html

# Arquivos do repositório que não são do site: testes, documentação interna, o programa do
# painel Multicam (roda no computador da modelo, não no site) e o próprio Git.
RedirectMatch 404 ^/(\.git|scripts|docs|painel-multicam)(/|$)
<FilesMatch "^(README\.md|\.gitignore|\.htaccess)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
